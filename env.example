# Saul local configuration template.
#
# Copy this file to `.env` in the repo root and fill in your own values:
#     cp env.example .env
# `.env` is gitignored. Never commit real phone numbers, keys, or passcodes
# (CLAUDE.md "Never" rules; docs/compliance/data-handling.md).
# Variable meanings: docs/ARCHITECTURE.md -> Configuration.

# --- API keys -------------------------------------------------------------
# Guava API key: app.goguava.ai -> API Keys page (docs: getting-started/sdk-quickstart).
# The SDK reads it from this variable. The CLI can use your `guava login` session instead.
GUAVA_API_KEY=your-guava-api-key
# The Guava number the agent answers on (E.164), from `guava numbers list`.
GUAVA_AGENT_NUMBER=+1XXXXXXXXXX

# --- Live-line gate (hackathon test line; never publish the number) ------
# Team phones allowed to reach the live agent. E.164, comma-separated, no spaces.
# Add your own number for testing. Every other caller is declined unanswered.
# The person running the live demo needs every tester's number in *their* .env:
# share numbers privately (DM or password manager), never in git or chat channels.
LIVE_CALLER_ALLOWLIST=+1XXXXXXXXXX,+1XXXXXXXXXX
# Spoken (or keyed) after an allowlist match, before any intake. Share privately.
SAUL_TEAM_PASSCODE=
# Secret code for the team-only WebRTC backup line (`guava webrtc create-code`).
SAUL_WEBRTC_TEAM_CODE=

# --- Process mode ---------------------------------------------------------
# `live` for phone/WebRTC runs. `eval` is set by evals/run.py only: draft
# playbooks load only in eval, and live listeners refuse to start there (ADR 0004).
SAUL_PROCESS_KIND=live

# --- Dev only ---------------------------------------------------------------
# 1 enables /dev/outbox on 127.0.0.1 (shows sent codes). Refused while listen_phone is active.
SAUL_DEV_OUTBOX=0
